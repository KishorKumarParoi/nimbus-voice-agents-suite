# ==============================================================================
# Nimbus Voice Agents Suite - Example Environment Configuration
# ==============================================================================

ENV=production
DEBUG=false
PROJECT_NAME="Nimbus Voice Agents Suite"
APP_URL=https://nimbus.kishor.tech

# OpenAI API Key (Whisper ASR, LLM Reasoning, OpenAI TTS)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs (Ultra-low latency streaming TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# LiveKit WebRTC Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Voice Pipeline Configurations
DEFAULT_ASR_PROVIDER=browser
DEFAULT_TTS_PROVIDER=elevenlabs
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_ENDPOINT_SILENCE_MS=600
ENABLE_RAG_BY_DEFAULT=false

